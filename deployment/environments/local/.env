# Local lab credentials and settings.
# Values are read by docker-compose.yml in this folder.
# Note: a literal '$' must be written as '$$'.

# OLTP (PostgreSQL)
OLTP_DB=oltp
OLTP_USER=oltpadmin
OLTP_PASSWORD=ChangeMe!
OLTP_PORT=9432

# OLAP / analytics (TimescaleDB)
OLAP_DB=olap
OLAP_USER=olapadmin
OLAP_PASSWORD=ChangeMe!
OLAP_PORT=9433

# pgAdmin
PGADMIN_EMAIL=admin@nodomain.com
PGADMIN_PASSWORD=admin
PGADMIN_PORT=9050

# Grafana
GRAFANA_USER=admin
GRAFANA_PASSWORD=ChangeMe!
GRAFANA_PORT=9000
