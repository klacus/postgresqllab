{
  "uid": "postgresqllab-health",
  "title": "PostgreSQL Lab Health",
  "tags": ["postgresqllab"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "panels": [
    {
      "type": "stat",
      "title": "OLAP uptime",
      "id": 1,
      "gridPos": { "h": 5, "w": 6, "x": 0, "y": 0 },
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "olap" },
      "fieldConfig": {
        "defaults": { "unit": "s", "color": { "mode": "thresholds" } },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT extract(epoch FROM now() - pg_postmaster_start_time()) AS uptime;"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Active connections",
      "id": 2,
      "gridPos": { "h": 5, "w": 6, "x": 6, "y": 0 },
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "olap" },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT count(*) AS connections FROM pg_stat_activity WHERE datname = current_database();"
        }
      ]
    },
    {
      "type": "stat",
      "title": "fact_sales rows",
      "id": 3,
      "gridPos": { "h": 5, "w": 6, "x": 12, "y": 0 },
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "olap" },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT count(*) AS rows FROM sampledw.fact_sales;"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Hypertable chunks",
      "id": 4,
      "gridPos": { "h": 5, "w": 6, "x": 18, "y": 0 },
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "olap" },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT count(*) AS chunks FROM timescaledb_information.chunks WHERE hypertable_schema = 'sampledw';"
        }
      ]
    },
    {
      "type": "table",
      "title": "Background jobs",
      "id": 5,
      "gridPos": { "h": 9, "w": 24, "x": 0, "y": 5 },
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "olap" },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT j.job_id, j.proc_name, j.hypertable_name, j.schedule_interval, s.last_run_status, s.last_successful_finish, s.total_failures FROM timescaledb_information.jobs j LEFT JOIN timescaledb_information.job_stats s USING (job_id) ORDER BY j.job_id;"
        }
      ]
    }
  ]
}
